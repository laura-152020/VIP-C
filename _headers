/*
  Content-Security-Policy: frame-ancestors 'self' https://experience.arcgis.com https://*.arcgis.com
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self "https://experience.arcgis.com"), camera=(self), microphone=(), clipboard-read=(self "https://experience.arcgis.com")
  Strict-Transport-Security: max-age=31536000

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
